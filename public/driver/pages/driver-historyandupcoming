<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carosa - My Rides</title>
    <link href='https://cdn.boxicons.com/2.1.4/css/boxicons.min.css' rel='stylesheet'>
    <style>
        /* --- CAROSA DESIGN SYSTEM --- */
        :root {
            /* Colors */
            --primary: #4F46E5;
            --primary-dark: #4338ca;
            --primary-light: #e0e7ff;
            --background: #f3f4f6;
            --background-alt: #ffffff;
            --background-hover: #f9fafb;
            --text-primary: #111827;
            --text-secondary: #6b7280;
            --text-muted: #9ca3af;
            --accent: #8b5cf6;
            --success: #10b981;
            --warning: #f59e0b;
            --error: #ef4444;

            /* Spacing */
            --spacing-xl: 3rem;
            --spacing-lg: 2rem;
            --spacing-md: 1rem;
            --spacing-sm: 0.5rem;

            /* Typography */
            --font-size-3xl: 2.25rem;
            --font-size-2xl: 1.5rem;
            --font-size-xl: 1.25rem;
            --font-size-lg: 1.125rem;
            --font-size-base: 1rem;
            --font-size-sm: 0.875rem;

            --radius-lg: 0.75rem;
            --radius-md: 0.375rem;
            --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
            --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1);
        }

        /* RESET & BASE */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
        
        body {
            background-color: var(--background);
            color: var(--text-primary);
            padding-bottom: var(--spacing-xl);
        }

        /* HEADER */
        .header {
            background: var(--background-alt);
            padding: var(--spacing-md) 0;
            border-bottom: 1px solid var(--primary-light);
            margin-bottom: var(--spacing-lg);
        }
        .header-content {
            max-width: 800px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 var(--spacing-md);
        }
        .logo { font-weight: 800; font-size: var(--font-size-xl); color: var(--primary); text-decoration: none; }
        .nav-link { text-decoration: none; color: var(--text-secondary); font-weight: 500; margin-left: var(--spacing-md); transition: color 0.2s; }
        .nav-link:hover, .nav-link.active { color: var(--primary); }

        /* MAIN LAYOUT */
        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 var(--spacing-md);
        }

        /* TABS */
        .tabs-container {
            display: flex;
            background: var(--background-alt);
            padding: 4px;
            border-radius: var(--radius-lg);
            margin-bottom: var(--spacing-lg);
            box-shadow: var(--shadow-sm);
        }
        .tab {
            flex: 1;
            padding: var(--spacing-md);
            text-align: center;
            border: none;
            background: transparent;
            color: var(--text-secondary);
            font-weight: 600;
            cursor: pointer;
            border-radius: var(--radius-md);
            transition: all 0.2s ease;
        }
        .tab.active {
            background: var(--primary-light);
            color: var(--primary);
        }

        /* RIDE CARDS */
        .ride-card {
            background: var(--background-alt);
            border-radius: var(--radius-lg);
            padding: var(--spacing-lg);
            margin-bottom: var(--spacing-md);
            box-shadow: var(--shadow-sm);
            border: 1px solid transparent;
            transition: transform 0.2s;
        }
        .ride-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .ride-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--spacing-md);
            padding-bottom: var(--spacing-sm);
            border-bottom: 1px solid var(--background);
        }
        .ride-date {
            font-weight: 600;
            color: var(--text-primary);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .ride-route {
            display: flex;
            align-items: center;
            gap: var(--spacing-md);
            margin-bottom: var(--spacing-md);
        }
        .location { font-size: var(--font-size-lg); font-weight: 500; }
        .arrow-icon { color: var(--text-muted); font-size: 1.2rem; }

        .ride-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: var(--spacing-md);
        }

        /* STATUS BADGES */
        .badge {
            font-size: 0.75rem;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .status-upcoming { background: #e0e7ff; color: var(--primary); }
        .status-completed { background: #ecfdf5; color: var(--success); }
        .status-cancelled { background: #f3f4f6; color: var(--text-muted); }

        /* EARNINGS & INFO */
        .info-pill {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: var(--font-size-sm);
            color: var(--text-secondary);
            background: var(--background);
            padding: 4px 8px;
            border-radius: var(--radius-md);
        }
        .earnings {
            font-weight: 700;
            color: var(--success);
            font-size: var(--font-size-lg);
        }
        
        /* ACTION BUTTONS */
        .btn-sm {
            padding: 6px 12px;
            border-radius: var(--radius-md);
            font-size: var(--font-size-sm);
            font-weight: 600;
            cursor: pointer;
            border: 1px solid var(--primary);
            background: transparent;
            color: var(--primary);
            transition: all 0.2s;
        }
        .btn-sm:hover {
            background: var(--primary);
            color: white;
        }

        /* Sections Toggle */
        .section-view { display: none; }
        .section-view.active { display: block; animation: fadeIn 0.3s; }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <header class="header">
        <div class="header-content">
            <a href="#" class="logo">Carosa Driver</a>
            <nav>
                <a href="driver_requests.html" class="nav-link">Requests</a>
                <a href="post_ride.html" class="nav-link">Post Ride</a>
                <a href="#" class="nav-link active">My Rides</a>
            </nav>
        </div>
    </header>

    <main class="container">
        
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--spacing-md);">
            <h1>My Rides</h1>
            <div style="text-align: right;">
                <span style="display: block; font-size: var(--font-size-sm); color: var(--text-secondary);">Total Earnings</span>
                <span style="font-weight: 800; font-size: var(--font-size-xl); color: var(--primary);">₱4,250.00</span>
            </div>
        </div>

        <!-- TABS -->
        <div class="tabs-container">
            <button class="tab active" onclick="switchTab('upcoming', this)">Upcoming (2)</button>
            <button class="tab" onclick="switchTab('completed', this)">Completed</button>
        </div>

        <!-- UPCOMING RIDES LIST -->
        <div id="upcoming" class="section-view active">
            
            <!-- Card 1 -->
            <article class="ride-card">
                <div class="ride-header">
                    <div class="ride-date">
                        <i class='bx bx-calendar'></i> Today, 5:30 PM
                    </div>
                    <span class="badge status-upcoming">Scheduled</span>
                </div>
                
                <div class="ride-route">
                    <span class="location">Baguio City</span>
                    <i class='bx bx-right-arrow-alt arrow-icon'></i>
                    <span class="location">La Trinidad</span>
                </div>

                <div style="display: flex; gap: 8px; margin-bottom: var(--spacing-md);">
                    <span class="info-pill"><i class='bx bx-user'></i> 3/4 Seats</span>
                    <span class="info-pill"><i class='bx bx-coin'></i> ₱65/head</span>
                </div>

                <div class="ride-footer">
                    <span style="color: var(--text-muted); font-size: var(--font-size-sm);">Posted 2 hours ago</span>
                    <button class="btn-sm" onclick="window.location.href='driver_trip_manage.html'">Manage Trip</button>
                </div>
            </article>

            <!-- Card 2 -->
            <article class="ride-card">
                <div class="ride-header">
                    <div class="ride-date">
                        <i class='bx bx-calendar'></i> Tomorrow, 8:00 AM
                    </div>
                    <span class="badge status-upcoming">Scheduled</span>
                </div>
                
                <div class="ride-route">
                    <span class="location">SM Baguio</span>
                    <i class='bx bx-right-arrow-alt arrow-icon'></i>
                    <span class="location">San Juan, LU</span>
                </div>

                <div style="display: flex; gap: 8px; margin-bottom: var(--spacing-md);">
                    <span class="info-pill"><i class='bx bx-user'></i> 1/6 Seats</span>
                    <span class="info-pill"><i class='bx bx-coin'></i> ₱150/head</span>
                </div>

                <div class="ride-footer">
                    <span style="color: var(--text-muted); font-size: var(--font-size-sm);">Posted yesterday</span>
                    <button class="btn-sm">Edit Details</button>
                </div>
            </article>
        </div>

        <!-- COMPLETED RIDES LIST -->
        <div id="completed" class="section-view">
            
            <!-- Past Ride 1 -->
            <article class="ride-card">
                <div class="ride-header">
                    <div class="ride-date" style="color: var(--text-secondary);">
                        <i class='bx bx-check-circle'></i> Oct 24, 2:00 PM
                    </div>
                    <span class="badge status-completed">Completed</span>
                </div>
                
                <div class="ride-route" style="opacity: 0.8;">
                    <span class="location">Burnham Park</span>
                    <i class='bx bx-right-arrow-alt arrow-icon'></i>
                    <span class="location">Mines View</span>
                </div>

                <div class="ride-footer">
                    <span class="info-pill">4 Passengers</span>
                    <span class="earnings">+ ₱320.00</span>
                </div>
            </article>

            <!-- Past Ride 2 -->
            <article class="ride-card">
                <div class="ride-header">
                    <div class="ride-date" style="color: var(--text-secondary);">
                        <i class='bx bx-check-circle'></i> Oct 22, 9:00 AM
                    </div>
                    <span class="badge status-completed">Completed</span>
                </div>
                
                <div class="ride-route" style="opacity: 0.8;">
                    <span class="location">Baguio City</span>
                    <i class='bx bx-right-arrow-alt arrow-icon'></i>
                    <span class="location">Rosario, LU</span>
                </div>

                <div class="ride-footer">
                    <span class="info-pill">3 Passengers</span>
                    <span class="earnings">+ ₱450.00</span>
                </div>
            </article>

            <!-- Cancelled Ride Example -->
            <article class="ride-card" style="opacity: 0.7;">
                <div class="ride-header">
                    <div class="ride-date" style="color: var(--text-muted);">
                        Oct 20, 1:00 PM
                    </div>
                    <span class="badge status-cancelled">Cancelled</span>
                </div>
                
                <div class="ride-route">
                    <span class="location">Session Rd</span>
                    <i class='bx bx-right-arrow-alt arrow-icon'></i>
                    <span class="location">Camp John Hay</span>
                </div>

                <div class="ride-footer">
                    <span class="info-pill">0 Passengers</span>
                    <span style="color: var(--text-muted); font-weight: 500;">₱0.00</span>
                </div>
            </article>

        </div>

    </main>

    <script>
        function switchTab(tabId, btnElement) {
            // Hide all sections
            document.querySelectorAll('.section-view').forEach(el => el.classList.remove('active'));
            
            // Show selected section
            document.getElementById(tabId).classList.add('active');

            // Update tab button styles
            document.querySelectorAll('.tab').forEach(el => el.classList.remove('active'));
            btnElement.classList.add('active');
        }
    </script>
</body>
</html>